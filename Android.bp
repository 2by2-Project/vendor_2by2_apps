android_app_import {
    name: "AuroraStore",
    apk: "AuroraStore/AuroraStore.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    required: ["privapp-permissions-com.aurora.store.xml"],
    optional_uses_libs: ["androidx.window.extensions", "androidx.window.sidecar"],
}

prebuilt_etc {
    name: "privapp-permissions-com.aurora.store.xml",
    src: "AuroraStore/privapp-permissions-com.aurora.store.xml",
    relative_install_path: "permissions",
    product_specific: true,
}

android_app_import {
    name: "AuroraServices",
    apk: "AuroraServices/AuroraServices.apk",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    required: ["privapp-permissions-com.aurora.services.xml"],
}

prebuilt_etc {
    name: "privapp-permissions-com.aurora.services.xml",
    src: "AuroraServices/privapp-permissions-com.aurora.services.xml",
    relative_install_path: "permissions",
    product_specific: true,
}
